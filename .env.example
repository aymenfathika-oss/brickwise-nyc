# Required: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: raises your NYC Open Data rate limit (free, instant, at
# https://data.cityofnewyork.us/profile/app_tokens). App works without it,
# just with a lower request ceiling. Must keep the NEXT_PUBLIC_ prefix —
# this one is read in the browser, unlike ANTHROPIC_API_KEY above.
NEXT_PUBLIC_NYC_OPEN_DATA_APP_TOKEN=
